# ---- Database ----
MONGODB_URI="mongodb+srv://user:pass@cluster0.mongodb.net/kaizen?retryWrites=true&w=majority"

# ---- Auth ----
# Generate a strong secret:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
# Session lifetime in days (spec: keep users logged in >= 1 month)
SESSION_DAYS=30

# ---- AI providers (one AI review/day is enforced server-side) ----
# Primary (Google Gemini)
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-1.5-flash"
# Fallback (xAI Grok — OpenAI-compatible API)
XAI_API_KEY="xai-..."
XAI_MODEL="grok-2-latest"
XAI_BASE_URL="https://api.x.ai/v1"

# ---- Razorpay (Individual plan) ----
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"
RAZORPAY_WEBHOOK_SECRET="xxx"
# Prices in paise (₹49 = 4900, ₹499 = 49900)
PRICE_MONTHLY_PAISE=4900
PRICE_YEARLY_PAISE=49900
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxx"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
